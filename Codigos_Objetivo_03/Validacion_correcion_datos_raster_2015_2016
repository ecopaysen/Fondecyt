"""

import arcpy
from arcpy.sa import *
import os
from datetime import datetime

# Activar Spatial Analyst
arcpy.CheckOutExtension("Spatial")

# ---------------------------------------------------
# TIMESTAMP DE PROCESAMIENTO
# ---------------------------------------------------

timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
print(f"Inicio de procesamiento: {timestamp}")
print("="*80)

# ---------------------------------------------------
# RUTAS DE ENTRADA
# ---------------------------------------------------

# Raster de asentamientos 2016 (fuente de validación)
raster_entrada = r"C:\Users\valen\Desktop\Fondecyt\settlements\Asentamientos_raster_Buffer\Asen_buf_2016.tif"

# Shapefile con buffers de AP
buffer_shp = r"C:\Users\valen\Desktop\Fondecyt\areas_protegidas_totales_actualizadas-20251109T203707Z-1-001\Buffer\Buffer_consecutivos\Buffer_clip\Buffer_clip_modificacion_v6\Buffer_10km_clip.shp"

# ---------------------------------------------------
# CARPETA DE SALIDA
# ---------------------------------------------------

carpeta_salida = r"C:\Users\valen\Desktop\Fondecyt\settlements\Asentamientos_raster_Buffer\Mascara_modificaciones_Asen_buffer"

# Crear carpeta si no existe
if not os.path.exists(carpeta_salida):
    os.makedirs(carpeta_salida)
    print(f"✓ Carpeta de salida creada: {carpeta_salida}")

# ---------------------------------------------------
# ÁREAS PROTEGIDAS A VALIDAR Y CORREGIR
# ---------------------------------------------------

areas_objetivo = [
    "RN Los Bellotos Del Melado",
    "RN Radal Siete Tazas",
    "RN Nalcas"
]

# ---------------------------------------------------
# INFORMACIÓN DE CORRECCIONES
# ---------------------------------------------------

CORRECCIONES_INFO = {
    "RN Nalcas": {
        "region": "Región del Maule",
        "inconsistencias": "Clasificación errónea de píxeles antrópicos",
        "año_validacion": 2016
    },
    "RN Radal Siete Tazas": {
        "region": "Región del Maule",
        "inconsistencias": "Variabilidad temporal anomalía",
        "año_validacion": 2016
    },
    "RN Los Bellotos Del Melado": {
        "region": "Región del Maule",
        "inconsistencias": "Cambios no justificados 2015-2016",
        "año_validacion": 2016
    }
}

# ---------------------------------------------------
# CREAR LAYER TEMPORAL
# ---------------------------------------------------

buffer_layer = "buffer_layer_validacion"

arcpy.MakeFeatureLayer_management(
    buffer_shp,
    buffer_layer
)

print(f"\n✓ Layer temporal creado: {buffer_layer}")

# ---------------------------------------------------
# PROCESAR CADA ÁREA PROTEGIDA
# ---------------------------------------------------

contador_procesadas = 0
estadisticas_procesamiento = []

for nombre_area in areas_objetivo:

    print("\n" + "="*80)
    print(f"VALIDANDO Y GENERANDO MÁSCARA: {nombre_area}")
    print("="*80)

    # Información de corrección
    info = CORRECCIONES_INFO.get(nombre_area, {})
    if info:
        print(f"  Región: {info.get('region', 'N/A')}")
        print(f"  Inconsistencias detectadas: {info.get('inconsistencias', 'N/A')}")
        print(f"  Año de validación: {info.get('año_validacion', 'N/A')}")

    # -----------------------------------------------
    # SELECCIÓN POR ATRIBUTO
    # -----------------------------------------------

    expresion = f""""NOMBRE_TOT" = '{nombre_area}'"""

    try:
        arcpy.SelectLayerByAttribute_management(
            buffer_layer,
            "NEW_SELECTION",
            expresion
        )
        print(f"  ✓ Selección por atributo realizada")
    except Exception as e:
        print(f"  ✗ Error en selección: {e}")
        continue

    # -----------------------------------------------
    # EXTRAER RASTER POR MÁSCARA
    # -----------------------------------------------

    try:
        raster_recortado = ExtractByMask(
            raster_entrada,
            buffer_layer
        )
        print(f"  ✓ Raster extraído por máscara")
    except Exception as e:
        print(f"  ✗ Error en extracción: {e}")
        continue

    # -----------------------------------------------
    # CREAR MÁSCARA SOLO CON PÍXELES ANTRÓPICOS (valor 1)
    # -----------------------------------------------

    try:
        mascara_1 = SetNull(
            raster_recortado != 1,
            1
        )
        print(f"  ✓ Máscara creada (píxeles valor 1 = antrópicos)")
    except Exception as e:
        print(f"  ✗ Error en creación de máscara: {e}")
        continue

    # -----------------------------------------------
    # PREPARAR NOMBRE DE SALIDA LIMPIO
    # -----------------------------------------------

    nombre_salida = (
        nombre_area
        .replace(" ", "_")
        .replace("/", "_")
    )

    salida_final = os.path.join(
        carpeta_salida,
        f"Mascara_{nombre_salida}_2016.tif"
    )

    # -----------------------------------------------
    # GUARDAR MÁSCARA CORREGIDA
    # -----------------------------------------------

    try:
        mascara_1.save(salida_final)
        print(f"  ✓ Máscara guardada: {os.path.basename(salida_final)}")
        
        # Registrar estadísticas
        contador_procesadas += 1
        estadisticas_procesamiento.append({
            "area": nombre_area,
            "archivo": os.path.basename(salida_final),
            "ruta_completa": salida_final,
            "timestamp": timestamp,
            "año_fuente": 2016,
            "estado": "✓ Completado"
        })
        
    except Exception as e:
        print(f"  ✗ Error al guardar máscara: {e}")
        estadisticas_procesamiento.append({
            "area": nombre_area,
            "estado": "✗ Error"
        })
        continue

# ---------------------------------------------------
# REPORTE FINAL
# ---------------------------------------------------

print("\n" + "="*80)
print("REPORTE FINAL DE VALIDACIÓN Y CORRECCIÓN")
print("="*80)

print(f"\nÁreas procesadas: {contador_procesadas}/{len(areas_objetivo)}")
print(f"Timestamp: {timestamp}")

if estadisticas_procesamiento:
    print("\nDetalles de procesamiento:")
    for i, stat in enumerate(estadisticas_procesamiento, 1):
        print(f"\n{i}. {stat.get('area', 'N/A')}")
        print(f"   Estado: {stat.get('estado', 'N/A')}")
        if 'archivo' in stat:
            print(f"   Archivo: {stat['archivo']}")
            print(f"   Año de validación: {stat['año_fuente']}")

print("\n" + "="*80)
print(f"Carpeta de salida: {carpeta_salida}")
print("="*80)

if contador_procesadas == len(areas_objetivo):
    print("\n🎉 VALIDACIÓN Y GENERACIÓN DE MÁSCARAS COMPLETADA EXITOSAMENTE")
    print("\nPasos siguientes:")
    print("  1. Revisar máscaras generadas")
    print("  2. Usar script: Aplicacion_Correccion_Datos_Historicos_2015.py")
    print("  3. Aplicar máscaras al raster de 2015")
else:
    print(f"\n⚠ PROCESAMIENTO COMPLETADO CON {len(areas_objetivo) - contador_procesadas} ERROR(ES)")

# Liberar extensión
arcpy.CheckInExtension("Spatial")

timestamp_final = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
print(f"\nFin de procesamiento: {timestamp_final}")
print("="*80)
