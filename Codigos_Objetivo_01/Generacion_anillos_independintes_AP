"""

import arcpy
import os
import time

print("\n" + "="*70)
print("GENERADOR DE ANILLOS INDEPENDIENTES - FONDECYT")
print("="*70)

# ======================================================
# CONFIGURACIÓN - MODIFICA ESTAS RUTAS SEGÚN TUS DATOS
# ======================================================

# RUTA DE ENTRADA - Shapefile con Áreas Protegidas
ruta_ap = r"[CAMBIAR_POR_RUTA_AP]\AP_terrestres.shp"

# RUTA DE SALIDA - Directorio donde guardar los anillos generados
ruta_salida_anillos = r"[CAMBIAR_POR_RUTA_SALIDA]\Anillos_generados"

# Distancias en kilómetros a procesar
distancias_km = list(range(1, 11))

# Crear directorio de salida si no existe
os.makedirs(ruta_salida_anillos, exist_ok=True)

print("\n📋 CONFIGURACIÓN:")
print(f"  AP: {ruta_ap}")
print(f"  Salida anillos: {ruta_salida_anillos}")
print(f"  Distancias: {distancias_km} km")

# ======================================================
# VERIFICAR
# ======================================================
print("\n✓ Verificando archivos...")

if not arcpy.Exists(ruta_ap):
    print(f"❌ ERROR: No encontré {ruta_ap}")
    exit(1)

print("  ✓ Archivos encontrados")

# ======================================================
# CARGAR DATOS
# ======================================================
print("\n📊 Cargando datos...")

result = arcpy.management.GetCount(ruta_ap)
num_ap = int(result[0])
print(f"  ✓ AP cargadas: {num_ap} features")

print("\n" + "="*70)
print("GENERANDO ANILLOS PARA TODAS LAS ÁREAS PROTEGIDAS")
print("="*70)

# ======================================================
# PROCESAR CADA DISTANCIA
# ======================================================

tiempo_inicio = time.time()
lista_salidas = []

for km in distancias_km:
    
    print(f"\n{'='*70}")
    print(f"GENERANDO ANILLO {km}km")
    print(f"{'='*70}")
    
    tiempo_km_inicio = time.time()
    
    # Nombre del shapefile de salida
    nombre_salida = f"Anillo_{km}km.shp"
    ruta_salida = os.path.join(ruta_salida_anillos, nombre_salida)
    
    print(f"\n📍 Procesando {num_ap} APs para crear anillo independiente de {km}km...")
    
    # Lista temporal para almacenar todos los anillos
    lista_geometrias_anillo = []
    lista_ids_ap = []
    lista_nombres_ap = []
    
    # Iterar sobre cada AP
    cursor = arcpy.da.SearchCursor(ruta_ap, 
        ['OID@', 'SHAPE@', 'NOMBRE_TOT'])
    
    idx_ap = 0
    for row in cursor:
        idx_ap += 1
        
        oid_ap = row[0]
        geometry_ap = row[1]
        nombre_ap = str(row[2]) if row[2] else f'AP_{oid_ap}'
        
        # Crear buffer de km km (buffer actual)
        buffer_actual = geometry_ap.buffer(km * 1000)
        
        # Crear buffer anterior (km-1)
        if km == 1:
            # Para el primer anillo: anillo = buffer_1km - AP
            buffer_anterior = geometry_ap
        else:
            # Para anillos siguientes: anillo = buffer_km - buffer_(km-1)
            buffer_anterior = geometry_ap.buffer((km - 1) * 1000)
        
        # Crear anillo = anillo actual - anillo anterior
        anillo = buffer_actual.difference(buffer_anterior)
        
        if anillo is not None and anillo.area > 0:
            lista_geometrias_anillo.append(anillo)
            lista_ids_ap.append(oid_ap)
            lista_nombres_ap.append(nombre_ap)
        
        # Mostrar progreso cada 10 APs
        if idx_ap % 10 == 0 or idx_ap == num_ap:
            pct = round(idx_ap / num_ap * 100, 1)
            print(f"  {idx_ap}/{num_ap} ({pct}%) APs procesadas...")
    
    del cursor
    
    print(f"\n  ✓ Anillos geométricos creados: {len(lista_geometrias_anillo)}")
    
    # ======================================================
    # CREAR SHAPEFILE DE SALIDA
    # ======================================================
    
    print(f"\n  📝 Creando shapefile: {nombre_salida}")
    
    try:
        # Crear shapefile de polígonos
        arcpy.management.CreateFeatureclass(
            ruta_salida_anillos,
            nombre_salida,
            geometry_type='POLYGON'
        )
        
        # Agregar campos
        arcpy.management.AddField(
            ruta_salida,
            'ID_AP',
            'LONG'
        )
        arcpy.management.AddField(
            ruta_salida,
            'NOMBRE_AP',
            'TEXT',
            field_length=255
        )
        arcpy.management.AddField(
            ruta_salida,
            'DISTANCIA_KM',
            'SHORT'
        )
        
        # Insertar geometrías
        with arcpy.da.InsertCursor(ruta_salida, ['SHAPE@', 'ID_AP', 'NOMBRE_AP', 'DISTANCIA_KM']) as cursor_insert:
            for i, geom_anillo in enumerate(lista_geometrias_anillo):
                cursor_insert.insertRow([
                    geom_anillo,
                    lista_ids_ap[i],
                    lista_nombres_ap[i],
                    km
                ])
        
        print(f"  ✓ Shapefile creado con {len(lista_geometrias_anillo)} features")
        
        tiempo_km_fin = time.time()
        tiempo_km = round(tiempo_km_fin - tiempo_km_inicio, 1)
        
        print(f"  ✅ Anillo {km}km completado ({tiempo_km}s)")
        print(f"     Guardado en: {ruta_salida}")
        
        lista_salidas.append({
            'distancia_km': km,
            'archivo': nombre_salida,
            'ruta_completa': ruta_salida,
            'num_features': len(lista_geometrias_anillo),
            'tiempo_s': tiempo_km
        })
        
    except Exception as e:
        print(f"  ❌ ERROR al crear anillo {km}km: {str(e)}")

tiempo_fin = time.time()
tiempo_total = round((tiempo_fin - tiempo_inicio) / 60, 1)

# ======================================================
# RESUMEN FINAL
# ======================================================

print("\n" + "="*70)
print("✅ GENERACIÓN DE ANILLOS COMPLETADA")
print("="*70 + "\n")

print("📊 RESUMEN FINAL:")
print(f"  Anillos generados: {len(lista_salidas)}/{len(distancias_km)}")
print(f"  Directorio de salida: {ruta_salida_anillos}")
print(f"  Tiempo total: {tiempo_total} minutos")
print()

print("📝 DETALLES DE ANILLOS GENERADOS:")
for item in lista_salidas:
    print(f"\n  Anillo {item['distancia_km']}km:")
    print(f"    Archivo: {item['archivo']}")
    print(f"    Features: {item['num_features']}")
    print(f"    Tiempo: {item['tiempo_s']}s")

print("\n" + "="*70)
print("RUTAS PARA USAR EN CÁLCULOS:")
print("="*70 + "\n")

print("Copiar en script de cálculos:\n")
for item in lista_salidas:
    ruta_relativa = item['ruta_completa']
    print(f"    {item['distancia_km']}: r\"{ruta_relativa}\",")

print("\n\n🎉 ¡ANILLOS GENERADOS EXITOSAMENTE!\n")
