}

construir_figura_sankey <- function(matriz_larga, anios_grafico, ancho_px, alto_px) {

  # Factor de escala: como ahora el grafico se genera directo en su tamaño
  # final (sin zoom posterior), los tamaños de fuente/nodo/margen que antes
  # estaban pensados para un canvas chico de 500px de alto deben escalarse
  # proporcionalmente al tamaño final real.
  escala <- alto_px / 500

  matriz_larga <- copy(as.data.table(matriz_larga))
  matriz_larga <- matriz_larga[clase_ini != "NoData" & clase_fin != "NoData"]
  if (nrow(matriz_larga) == 0) return(NULL)

  anio_min <- min(matriz_larga$anio_ini)
  comp_primer_anio <- matriz_larga[anio_ini == anio_min, .(area = sum(area_ha)), by = .(anio = anio_ini, clase = clase_ini)]
  comp_resto <- matriz_larga[, .(area = sum(area_ha)), by = .(anio = anio_fin, clase = clase_fin)]
  composicion <- rbind(comp_primer_anio, comp_resto)
  composicion[, pct := area / sum(area) * 100, by = anio]

  nombres_nodo_id <- character(0); nombres_nodo_label <- character(0)
  x_nodo <- numeric(0); color_nodo <- character(0); hover_nodo <- character(0)

  for (i in seq_along(anios_grafico)) {
    a <- anios_grafico[i]
    x_pos <- if (length(anios_grafico) > 1) 0.02 + (i - 1) * (0.96 / (length(anios_grafico) - 1)) else 0.5
    for (clase_interna in c("Natural", "Antropico")) {
      id_nodo <- paste0(clase_interna, "_", a)
      nombres_nodo_id <- c(nombres_nodo_id, id_nodo)
      fila_comp <- composicion[anio == a & clase == clase_interna]
      pct_valor <- if (nrow(fila_comp) > 0) round(fila_comp$pct, 1) else NA_real_
      nombre_clase_visible <- ifelse(clase_interna == "Natural", "Natural", "Anthropic")
      label_visible <- if (!is.na(pct_valor)) paste0(pct_valor, "%") else ""
      nombres_nodo_label <- c(nombres_nodo_label, label_visible)
      hover_nodo <- c(hover_nodo, paste0(nombre_clase_visible, " ", a, ": ", pct_valor, "%"))
      x_nodo <- c(x_nodo, x_pos)
      color_nodo <- c(color_nodo, if (clase_interna == "Natural") color_natural else color_antropico)
    }
  }

  nodos <- data.table(id = nombres_nodo_id, label = nombres_nodo_label, x = x_nodo, color = color_nodo, hover = hover_nodo)
  nodos[, idx := .I - 1]

  matriz_larga[, nodo_origen := paste0(clase_ini, "_", anio_ini)]
  matriz_larga[, nodo_destino := paste0(clase_fin, "_", anio_fin)]
  matriz_larga <- merge(matriz_larga, nodos[, .(id, idx)], by.x = "nodo_origen", by.y = "id", all.x = TRUE)
  setnames(matriz_larga, "idx", "source_idx")
  matriz_larga <- merge(matriz_larga, nodos[, .(id, idx)], by.x = "nodo_destino", by.y = "id", all.x = TRUE)
  setnames(matriz_larga, "idx", "target_idx")
  matriz_larga[, color_link := fifelse(clase_ini == "Natural", color_link_natural, color_link_antropico)]

  fig <- plot_ly(
    type = "sankey", orientation = "h", arrangement = "snap",
    width = ancho_px, height = alto_px,
    node = list(label = nodos$label, x = nodos$x, color = nodos$color,
                pad = 14 * escala, thickness = 20 * escala, line = list(color = "white", width = 0.5 * escala),
                hovertemplate = paste0(nodos$hover, "<extra></extra>")),
    link = list(source = matriz_larga$source_idx, target = matriz_larga$target_idx,
                value = matriz_larga$area_ha, color = matriz_larga$color_link,
                hovertemplate = paste0("%{source.label} -> %{target.label}<br>Area: %{value:,.0f} ha<extra></extra>")),
    textfont = list(size = 11 * escala, color = "black")
  )

  anotaciones <- lapply(seq_along(anios_grafico), function(i) {
    x_pos <- if (length(anios_grafico) > 1) 0.02 + (i - 1) * (0.96 / (length(anios_grafico) - 1)) else 0.5
    list(x = x_pos, y = 1.06, xref = "paper", yref = "paper", text = paste0("<b>", anios_grafico[i], "</b>"),
         showarrow = FALSE, font = list(size = 15 * escala, color = "black"), xanchor = "center")
  })

  anotacion_leyenda <- list(
    list(x = 0.5, y = -0.085, xref = "paper", yref = "paper", showarrow = FALSE,
         text = "<b>Legend</b>", font = list(size = 11 * escala, color = "#555555"), xanchor = "center"),
    list(x = 0.47, y = -0.115, xref = "paper", yref = "paper", showarrow = FALSE,
         text = paste0("<span style='color:", color_natural, "'>&#9632;</span> Natural"),
         font = list(size = 12 * escala, color = "black"), xanchor = "right"),
    list(x = 0.53, y = -0.115, xref = "paper", yref = "paper", showarrow = FALSE,
         text = paste0("<span style='color:", color_antropico, "'>&#9632;</span> Anthropic"),
         font = list(size = 12 * escala, color = "black"), xanchor = "left")
  )

  forma_marco_leyenda <- list(type = "rect", xref = "paper", yref = "paper",
                              x0 = 0.35, x1 = 0.65, y0 = -0.15, y1 = -0.035,
                              line = list(color = "#CCCCCC", width = 0.5 * escala), fillcolor = "white", layer = "below")

  fig <- fig %>% layout(
    annotations = c(anotaciones, anotacion_leyenda),
    shapes = list(forma_marco_leyenda),
    font = list(size = 12 * escala),
    margin = list(t = 55 * escala, b = 90 * escala, l = 10 * escala, r = 10 * escala)
  )

  return(fig)
}

exportar_grafico_sankey <- function(fig, nombre_base) {
  if (is.null(fig)) return(invisible(NULL))

  dir.create(file.path(dir_graficos, "01_HTML/English"), recursive = TRUE, showWarnings = FALSE)
  dir.create(file.path(dir_graficos, "02_TIFF_300dpi/English"), recursive = TRUE, showWarnings = FALSE)
  dir.create(file.path(dir_graficos, "03_PNG/English"), recursive = TRUE, showWarnings = FALSE)

  archivo_html <- file.path(dir_graficos, "01_HTML/English", paste0(nombre_base, ".html"))
  saveWidget(fig, archivo_html, selfcontained = TRUE)

  dims <- calcular_dimensiones_render(17, 10)
  tryCatch({
    archivo_png <- file.path(dir_graficos, "03_PNG/English", paste0(nombre_base, ".png"))
    webshot2::webshot(archivo_html, file = archivo_png, vwidth = dims$ancho_px_logico, vheight = dims$alto_px_logico, zoom = dims$zoom, delay = 20)
    archivo_tiff <- file.path(dir_graficos, "02_TIFF_300dpi/English", paste0(nombre_base, ".tiff"))
    img <- magick::image_read(archivo_png)
    magick::image_write(img, path = archivo_tiff, format = "tiff", density = "300x300")
    cat("    grafico exportado (HTML+PNG+TIFF):", nombre_base, "\n")
  }, error = function(e) {
    cat("    HTML ok, fallo PNG/TIFF:", conditionMessage(e), "\n")
  })
}


archivos_raster <- list.files(dir_rasters, pattern = "\\.tif$", full.names = TRUE, ignore.case = TRUE)
extraer_anio <- function(nombre) {
  m <- regmatches(nombre, regexpr("(19|20)[0-9]{2}", nombre))
  if (length(m) == 0) return(NA_integer_)
  as.integer(m)
}
anios_detectados <- sapply(basename(archivos_raster), extraer_anio)
names(anios_detectados) <- archivos_raster
ruta_raster_anio <- function(anio) {
  ruta <- names(anios_detectados)[anios_detectados == anio]
  if (length(ruta) != 1) stop("No se encontro raster unico para el año ", anio)
  ruta
}

raster_referencia <- rast(ruta_raster_anio(anios_serie[1]))
res_grados <- res(raster_referencia)

area_ha_analitica <- function(numeros_celda, raster_ref) {
  lat <- yFromCell(raster_ref, numeros_celda)
  lat_rad <- lat * pi / 180
  ancho_m <- res_grados[1] * (pi / 180) * radio_tierra_m * cos(lat_rad)
  alto_m  <- res_grados[2] * (pi / 180) * radio_tierra_m
  (ancho_m * alto_m) / 10000
}

clasificar_categoria <- function(valores) {
  out <- rep(NA_character_, length(valores))
  out[grepl("parque",    valores, ignore.case = TRUE)] <- "Parque Nacional"
  out[grepl("reserva",   valores, ignore.case = TRUE)] <- "Reserva Nacional"
  out[grepl("monumento", valores, ignore.case = TRUE)] <- "Monumento Natural"
  out
}

calcular_matriz_periodo <- function(poligonos, etiqueta, anio_ini, anio_fin) {
  n_poly <- nrow(as.data.frame(poligonos))
  if (n_poly == 0) return(NULL)
  r_ini <- rast(ruta_raster_anio(anio_ini)); names(r_ini) <- "clase_ini"
  r_fin <- rast(ruta_raster_anio(anio_fin)); names(r_fin) <- "clase_fin"
  stack_periodo <- c(r_ini, r_fin)
  valores_extraidos <- terra::extract(stack_periodo, poligonos, cells = TRUE, ID = FALSE)
  valores <- as.data.table(valores_extraidos)
  valores <- valores[!is.na(clase_ini) & !is.na(clase_fin)]
  if (nrow(valores) == 0) return(NULL)
  valores[, area_ha := area_ha_analitica(cell, r_ini)]
  matriz <- valores[, .(n_pixeles = .N, area_ha = sum(area_ha)), by = .(codigo_ini = clase_ini, codigo_fin = clase_fin)]
  matriz <- merge(matriz, clases_lulc, by.x = "codigo_ini", by.y = "codigo", all.x = TRUE)
  setnames(matriz, "clase", "clase_ini")
  matriz <- merge(matriz, clases_lulc, by.x = "codigo_fin", by.y = "codigo", all.x = TRUE)
  setnames(matriz, "clase", "clase_fin")
  matriz[, `:=`(anio_ini = anio_ini, anio_fin = anio_fin, periodo = paste0(anio_ini,"-",anio_fin), categoria = etiqueta)]
  return(matriz)
}

# Convierte el formato largo a matriz cuadrada 3x3 (NoData/Natural/Antropico)
# CON TOTALES MARGINALES, en dos unidades (hectareas y pixeles). Todos los
# periodos quedan APILADOS en un unico archivo por categoria (un bloque de
# tabla por periodo, uno debajo del otro), igual que en la tabla del paper.
guardar_matriz_cuadrada <- function(matriz_completa, etiqueta, tipo_calculo, dir_ha, dir_px) {

  clases_orden <- c("NoData", "Natural", "Antropico")
  periodos_unicos <- unique(matriz_completa$periodo)

  construir_tabla_periodo <- function(sub, anio_ini_p, anio_fin_p, campo_valor) {

    obtener_valor <- function(fila, columna) {
      v <- sub[clase_ini == fila & clase_fin == columna, get(campo_valor)]
      if (length(v) == 0) 0 else v
    }

    m <- matrix(0, nrow = 3, ncol = 3, dimnames = list(clases_orden, clases_orden))
    for (fi in clases_orden) for (fj in clases_orden) m[fi, fj] <- obtener_valor(fi, fj)

    totales_fila    <- rowSums(m)
    totales_columna <- colSums(m)
    total_general   <- sum(m)

    tabla <- data.table(Clase = c(
      paste0("Año ", anio_fin_p, " ->"),
      clases_orden,
      paste0("Total ", anio_ini_p)
    ))

    for (col in clases_orden) {
      tabla[[col]] <- c(col, round(m[, col], 2), round(totales_columna[col], 2))
    }

    tabla[["Total"]] <- c(
      paste0("Total ", anio_fin_p),
      round(totales_fila, 2),
      round(total_general, 2)
    )

    return(tabla)
  }

  construir_archivo_apilado <- function(campo_valor) {
    bloques <- list()
    for (p in periodos_unicos) {
      sub <- matriz_completa[periodo == p]
      anio_ini_p <- unique(sub$anio_ini)
      anio_fin_p <- unique(sub$anio_fin)

      # Fila titulo del bloque + la tabla del periodo + fila en blanco de separacion
      titulo <- data.table(Clase = paste0("Periodo ", p), NoData = "", Natural = "", Antropico = "", Total = "")
      tabla_periodo <- construir_tabla_periodo(sub, anio_ini_p, anio_fin_p, campo_valor)
      fila_vacia <- data.table(Clase = "", NoData = "", Natural = "", Antropico = "", Total = "")

      # Las columnas de tabla_periodo son character (por los encabezados de texto
      # mezclados con numeros), se homologan a texto para poder apilar todo
      tabla_periodo_txt <- tabla_periodo[, lapply(.SD, as.character)]

      bloques[[p]] <- rbind(titulo, tabla_periodo_txt, fila_vacia)
    }
    rbindlist(bloques)
  }

  tabla_ha_completa <- construir_archivo_apilado("area_ha")
  archivo_ha <- file.path(dir_ha, paste0("Matriz_Transicion_", gsub(" ","_",etiqueta), "_", tipo_calculo, "_ha.csv"))
  fwrite(tabla_ha_completa, archivo_ha)

  tabla_px_completa <- construir_archivo_apilado("n_pixeles")
  archivo_px <- file.path(dir_px, paste0("Matriz_Transicion_", gsub(" ","_",etiqueta), "_", tipo_calculo, "_pixeles.csv"))
  fwrite(tabla_px_completa, archivo_px)

  cat("    matriz cuadrada apilada (3x3, con NoData, ha + pixeles):", length(periodos_unicos), "periodo(s) en 1 archivo\n")
}

# TIPO 1: serie temporal, 6 periodos
calcular_serie_temporal <- function(poligonos, etiqueta) {
  cat("  serie_temporal_2000_2024 -", etiqueta, "\n")
  lista_periodos <- list()
  for (p in periodos) {
    m <- calcular_matriz_periodo(poligonos, etiqueta, p[1], p[2])
    if (!is.null(m)) lista_periodos[[paste0(p[1],"-",p[2])]] <- m
  }
  if (length(lista_periodos) == 0) { cat("    sin datos, se omite\n"); return(invisible(NULL)) }
  matriz_completa <- rbindlist(lista_periodos)
  guardar_matriz_cuadrada(matriz_completa, etiqueta, "serie_temporal_2000_2024", dir_serie_ha, dir_serie_px)

  # Cache interno (no es un CSV de reporte, es solo para que el script de
  # graficos pueda leer esto rapido despues, sin re-extraer el raster)
  saveRDS(matriz_completa, file.path(dir_cache, paste0(gsub(" ","_",etiqueta), "_serie_temporal.rds")))
}

# TIPO 2: comparacion extremos, 2000 vs 2024
calcular_comparacion_extremos <- function(poligonos, etiqueta) {
  cat("  comparacion_extremos_2000_2024 -", etiqueta, "\n")
  m <- calcular_matriz_periodo(poligonos, etiqueta, 2000, 2024)
  if (is.null(m)) { cat("    sin datos, se omite\n"); return(invisible(NULL)) }
  guardar_matriz_cuadrada(m, etiqueta, "comparacion_extremos_2000_2024", dir_comparacion_ha, dir_comparacion_px)

  saveRDS(m, file.path(dir_cache, paste0(gsub(" ","_",etiqueta), "_comparacion_extremos.rds")))
}


