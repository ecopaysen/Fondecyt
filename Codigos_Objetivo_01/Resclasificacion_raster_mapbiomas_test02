## =============================================================================
## RECLASIFICACIÓN TEST 02 — MapBiomas (raster de cobertura y uso de suelo)
## =============================================================================
##
## QUÉ HACE ESTE SCRIPT
## -----------------------------------------------------------------------------
## Toma uno o más rasters de cobertura y uso de suelo (por ejemplo, la serie
## anual de MapBiomas: 2000, 2004, 2008... hasta el año más reciente) y los
## reclasifica en un esquema simplificado de 3 clases, llamado "TEST 02":
##
##     0 = Sin datos / ND   (nubes, sombras, cuerpos de agua, hielo/nieve,
##                            o cualquier código no contemplado)
##     1 = Natural           (bosque, humedal, estepa, matorral, etc.)
##     2 = Antrópico          (agricultura, silvicultura, infraestructura,
##                            pastura, pastizal/pradera, etc.)
##
## Este esquema reducido sirve para analizar cambios de uso de suelo (por
## ejemplo, dentro y alrededor de áreas protegidas) sin necesitar las ~20-30
## clases originales de MapBiomas, que para ese tipo de análisis son más
## detalladas de lo necesario.
##
## DIFERENCIA CON TEST 1: el código 12 (Pastizal/Grassland) se clasifica
## como Antrópico (2) en TEST 02, mientras que en TEST 1 es Natural (1). Es
## una decisión metodológica propia de este esquema, no un error — ver
## Metodologia_Reclasificacion_TEST02.docx para el detalle.
##
## CÓMO USARLO
## -----------------------------------------------------------------------------
## 1. Instala el paquete 'terra' si no lo tienes: install.packages("terra")
## 2. Edita la sección "0. CONFIGURACIÓN" más abajo:
##      - INPUT_DIR / OUTPUT_DIR: carpetas de entrada y salida
##      - INPUT_PATTERN: cómo se llaman tus archivos de entrada
##      - YEARS: qué años/rasters vas a procesar
##      - La matriz de reclasificación (sección 2), si tu propia leyenda de
##        clases usa códigos distintos a los de MapBiomas
## 3. Corre el script completo (Ctrl+A, luego Ctrl+Enter en RStudio, o
##    `Rscript reclasificar_test02.R` desde la terminal).
##
## REQUISITOS
## -----------------------------------------------------------------------------
## - R >= 4.0
## - Paquete 'terra' (funciona con rasters grandes sin cargarlos completos
##   a memoria; no requiere ArcGIS ni licencias comerciales)
##
## =============================================================================


## =============================================================================
## 0. CONFIGURACIÓN — EDITA ESTA SECCIÓN SEGÚN TU CASO
## =============================================================================

# --- Carpetas de entrada y salida --------------------------------------------
# Reemplaza estas rutas por las de tu propio computador/proyecto.
# En Windows, usa "/" en vez de "\" (ej. "C:/Usuarios/Nombre/Datos"),
# o antepone "r" al string: r"(C:\Usuarios\Nombre\Datos)"

INPUT_DIR  <- "ruta/a/tus/rasters_originales"     # carpeta con los rasters SIN reclasificar
OUTPUT_DIR <- "ruta/a/tus/rasters_test02"         # carpeta donde se guardará el resultado

# --- Años o identificadores a procesar ---------------------------------------
# Puede ser una serie de años (como en este ejemplo) o cualquier otro
# identificador que uses para nombrar tus archivos (ej. nombres de región).

YEARS <- c(2000, 2004, 2008, 2012, 2016, 2020, 2024)

# --- Patrón de nombre de archivo ----------------------------------------------
# Función que arma el nombre del archivo de ENTRADA a partir del año/ID.
# Ajusta el sprintf() a como se llamen tus archivos.
# Ejemplo: si tus archivos son "cobertura_2000.tif", usa:
#   sprintf("cobertura_%d.tif", anio)

nombre_archivo_entrada <- function(anio) {
  sprintf("%d_lclu_reclass.tif", anio)
}

# Función que arma el nombre del archivo de SALIDA (reclasificado TEST 02).
nombre_archivo_salida <- function(anio) {
  sprintf("%d_test_02.tif", anio)
}


## =============================================================================
## 1. CARGA DE PAQUETES
## =============================================================================

if (!requireNamespace("terra", quietly = TRUE)) {
  stop(
    "El paquete 'terra' no está instalado. ",
    "Instálalo con: install.packages(\"terra\")"
  )
}
library(terra)


## =============================================================================
## 2. MATRIZ DE RECLASIFICACIÓN — TEST 02
## =============================================================================
## Aquí se define qué código original (de tu raster de entrada) corresponde
## a cada una de las 3 clases de salida. Los códigos de ejemplo a continuación
## corresponden a MapBiomas Chile, Colección 2 — AJÚSTALOS si tu leyenda de
## clases es distinta (otra colección de MapBiomas, otro país, u otra fuente
## de datos de cobertura de suelo).
##
## Para encontrar los códigos de tu propio raster, puedes:
##   a) Revisar la leyenda/documentación oficial de tu fuente de datos, o
##   b) Correr `freq(rast("tu_archivo.tif"))` en R para listar todos los
##      códigos que efectivamente aparecen en tus datos, y decidir a qué
##      clase (Natural / Antrópico / Sin datos) corresponde cada uno.

# Códigos que se consideran "Sin datos / ND" (0):
#   - Cuerpos de agua, hielo/nieve, nubes, sombras, o clases sin observación
CODIGOS_SIN_DATOS <- c(33, 34, 79, 80)

# Códigos que se consideran "Natural" (1):
#   - Bosque, humedal, estepa, matorral, afloramiento rocoso, etc.
CODIGOS_NATURAL <- c(3, 11, 23, 25, 29, 61, 63, 66)

# Códigos que se consideran "Antrópico" (2):
#   - Agricultura, silvicultura/plantaciones, infraestructura, pastura, y
#     pastizal/pradera (código 12 — a diferencia de TEST 1, donde ese mismo
#     código se clasifica como Natural).
CODIGOS_ANTROPICO <- c(9, 12, 15, 18, 24)

# Construcción de la tabla de reglas para terra::classify().
# Formato esperado: una matriz de 2 columnas, "is" (código original) y
# "becomes" (código de salida).
tabla_reclasificacion <- rbind(
  cbind(is = CODIGOS_SIN_DATOS,  becomes = 0),
  cbind(is = CODIGOS_NATURAL,    becomes = 1),
  cbind(is = CODIGOS_ANTROPICO,  becomes = 2)
)


## =============================================================================
## 3. FUNCIÓN PRINCIPAL: RECLASIFICAR UN RASTER
## =============================================================================

#' Reclasifica un raster de cobertura de suelo al esquema de 3 clases (TEST 02)
#'
#' @param ruta_entrada  Ruta al raster original (.tif) a reclasificar.
#' @param ruta_salida   Ruta donde se guardará el raster reclasificado.
#' @param tabla_reglas  Matriz de 2 columnas (is, becomes) con las reglas de
#'                       reclasificación. Por defecto usa `tabla_reclasificacion`
#'                       definida en la sección 2.
#'
#' @return El objeto SpatRaster reclasificado (además de escribirlo a disco).
reclasificar_raster <- function(ruta_entrada, ruta_salida, tabla_reglas = tabla_reclasificacion) {

  if (!file.exists(ruta_entrada)) {
    stop("No se encontró el archivo de entrada:\n  ", ruta_entrada)
  }

  # Cargar el raster. rast() solo lee metadatos (dimensiones, CRS, etc.),
  # no carga los valores de los píxeles a memoria todavía — por eso este
  # script funciona incluso con rasters muy grandes (ej. un país completo).
  r <- rast(ruta_entrada)

  # Algunos rasters de cobertura de suelo son "categóricos": el valor que
  # ves en un SIG (ej. "Bosque") en realidad se almacena como un código
  # numérico interno, con una tabla aparte que traduce código -> etiqueta.
  # Otros rasters son "numéricos directos": el valor de celda YA ES el
  # código de clase, sin tabla de traducción.
  # Este bloque detecta cuál de los dos casos aplica, y si es categórico,
  # deja los valores de celda como su código numérico puro antes de
  # reclasificar (para que la tabla de reglas de la sección 2 funcione
  # igual en ambos casos).
  tabla_categorias <- tryCatch(cats(r)[[1]], error = function(e) NULL)
  es_categorico <- !is.null(tabla_categorias) && nrow(tabla_categorias) > 0

  if (es_categorico) {
    message("  Formato detectado: CATEGÓRICO (con etiquetas de texto). Extrayendo código numérico...")
    levels(r) <- NULL  # deja el valor de celda como código numérico puro
  } else {
    message("  Formato detectado: NUMÉRICO DIRECTO (el valor de celda ya es el código de clase).")
  }

  # Reclasificación propiamente dicha.
  # - `tabla_reglas` indica qué código original se convierte en qué clase.
  # - `others = 0` asigna "Sin datos/ND" a CUALQUIER valor que no esté
  #   explícitamente en la tabla de reglas (incluye píxeles NA/vacíos del
  #   raster original). Esto evita que códigos no contemplados queden con
  #   un valor indefinido en la salida.
  # - `datatype = "INT1U"` guarda el resultado como enteros de 1 byte sin
  #   signo (0 a 255), que es más que suficiente para 3 clases (0, 1, 2) y
  #   ocupa mucho menos espacio en disco que el formato original.
  r_reclasificado <- classify(r, tabla_reglas, others = 0, datatype = "INT1U")

  # Crear la carpeta de salida si no existe todavía.
  dir.create(dirname(ruta_salida), recursive = TRUE, showWarnings = FALSE)

  writeRaster(r_reclasificado, ruta_salida, overwrite = TRUE, datatype = "INT1U")

  invisible(r_reclasificado)
}


## =============================================================================
## 4. EJECUCIÓN: RECLASIFICAR TODOS LOS AÑOS/ARCHIVOS CONFIGURADOS
## =============================================================================

n_total <- length(YEARS)

for (i in seq_along(YEARS)) {

  anio <- YEARS[i]

  ruta_entrada <- file.path(INPUT_DIR, nombre_archivo_entrada(anio))
  ruta_salida  <- file.path(OUTPUT_DIR, nombre_archivo_salida(anio))

  cat(sprintf("\n[%d/%d] Procesando: %s\n", i, n_total, anio))
  cat(sprintf("  Entrada: %s\n", ruta_entrada))
  cat(sprintf("  Salida:  %s\n", ruta_salida))

  tryCatch({
    reclasificar_raster(ruta_entrada, ruta_salida)
    cat("  Listo.\n")
  }, error = function(e) {
    cat("  ERROR al procesar este archivo:\n  ", conditionMessage(e), "\n")
    cat("  (el script continúa con el siguiente archivo)\n")
  })
}

cat("\n=====================================================================\n")
cat(sprintf("Reclasificación TEST 02 completada para %d archivo(s).\n", n_total))
cat("Revisa la carpeta de salida (OUTPUT_DIR) para ver los resultados.\n")
cat("=====================================================================\n")
